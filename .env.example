# Copy to .env (git-ignored) and fill in EVERY value. docker compose refuses to start while MSSQL_SA_PASSWORD or
# JWT_KEY is empty, and the API refuses to start with a placeholder or development signing key.
#
# Generate real secrets, for example:  openssl rand -base64 48
MSSQL_SA_PASSWORD=
JWT_KEY=

# Hostnames the API will answer to (comma or semicolon separated). Keep it as narrow as your deployment allows.
ALLOWED_HOSTS=localhost

# Demo data creates accounts whose password is published in the README. Only ever enable it for a throwaway demo.
SEED_DEMO_DATA=false
